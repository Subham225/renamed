{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Item template in catalog database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "aboutProduct": { "type": "string" },
        "deliveryCare": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isPersonalisedBestSeller": { "type": "boolean" },
        "personalisedBestSellerOrder": { "type": "number" },
        "isTwoHourDelivery": { "type": "boolean" },
        "deliveryFee": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } },
        "options": { "type": "object" },
        "weightPrices": { "type": "object" },
        "allowedWeights": { "type": "array", "items": { "type": "string" } },
        "addonProductIds": { "type": "array", "items": { "type": "string" } },
        "adminNote": { "type": "string" },
        "isHidden": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "category", "image", "description"]
    },
    "Order": {
      "title": "Order",
      "description": "A placed checkout order with full receipt details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "streetAddress": { "type": "string" },
        "pincode": { "type": "string" },
        "city": { "type": "string" },
        "landmark": { "type": "string" },
        "paymentMode": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "itemsSubtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "couponCode": { "type": "string" },
        "couponDiscountType": { "type": "string" },
        "couponDiscountValue": { "type": "number" },
        "discountAmount": { "type": "number" },
        "total": { "type": "number" },
        "deliveryOtp": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "deliveryDate": { "type": "string" },
        "deliveryTimeSlot": { "type": "string" }
      },
      "required": [
        "id",
        "customerName",
        "customerPhone",
        "recipientName",
        "recipientPhone",
        "streetAddress",
        "pincode",
        "city",
        "paymentMode",
        "total",
        "status",
        "date"
      ]
    },
    "Slide": {
      "title": "Slide",
      "description": "Promo home page carousel banner slice with customizable picture",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "buttonText": { "type": "string" },
        "accentColor": { "type": "string" }
      },
      "required": ["id", "image", "title", "subtitle"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Custom lookup gallery picture for front page display, managed by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "image"]
    },
    "DeliveryAgent": {
      "title": "DeliveryAgent",
      "description": "Information about registered delivery riders (such as Google integrated or passcode)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "type": { "type": "string" },
        "passcode": { "type": "string" }
      },
      "required": ["id", "name", "type"]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Store configuration document",
      "type": "object",
      "properties": {
        "deliveryZones": { "type": "array", "items": { "type": "object" } },
        "deliveryTimeSlots": { "type": "array", "items": { "type": "object" } },
        "aboutPoints": { "type": "array", "items": { "type": "string" } },
        "aboutBgImage": { "type": "string" },
        "manualClosed": { "type": "boolean" },
        "customStoreClosedMessage": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Store category metadata, display order, and visibility flags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" },
        "displayOrder": { "type": "number" },
        "isVisible": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "addonProductIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promo discount code configuration",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountType": { "type": "string" },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "showInCart": { "type": "boolean" }
      },
      "required": ["code", "discountType", "discountValue", "isActive"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Content-addressed compressed image data externalized from Firestore documents to bypass the 1 MiB document size limit",
      "type": "object",
      "properties": {
        "dataUrl": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["dataUrl", "updatedAt"]
    },
    "SellerApplication": {
      "title": "SellerApplication",
      "description": "Partner seller registration records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "pincode": { "type": "string" }
      }
    },
    "DeliveryAudit": {
      "title": "DeliveryAudit",
      "description": "Delivery run audit records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Exhaustive product list synced across devices"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store categories directory, ordering, and visibility toggles"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Active discount coupons synchronized with checkout"
    },
    "/media_assets/{mediaId}": {
      "schema": "MediaAsset",
      "description": "Content-addressed uploaded images referenced by products, categories, slides, gallery, and store_config"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase transaction records"
    },
    "/slides/{slideId}": {
      "schema": "Slide",
      "description": "Front page promo carousel slides state dynamic controls"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Visual decoration lookbook items list"
    },
    "/delivery_riders/{riderId}": {
      "schema": "DeliveryAgent",
      "description": "Dynamically registered active deliverers"
    },
    "/seller_applications/{sellerId}": {
      "schema": "SellerApplication",
      "description": "Seller applications submitted for admin review"
    },
    "/delivery_audits/{auditId}": {
      "schema": "DeliveryAudit",
      "description": "Delivery run audit trail logs"
    },
    "/store_config/{configId}": {
      "schema": "StoreConfig",
      "description": "Global store settings, subcategories, curations, and seeding metadata"
    }
  }
}
